{
	"name": "@canmi/web",
	"version": "0.0.0",
	"description": "SvelteKit compat, referer and Sentry.",
	"keywords": [
		"browserslist",
		"canmi",
		"core-js",
		"sentry",
		"sveltekit"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/canmi21/lib.git",
		"directory": "pkgs/web"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		"./compat": {
			"types": "./dist/compat/src/index.d.ts",
			"default": "./dist/compat/src/index.js"
		},
		"./compat/build": {
			"types": "./dist/compat/src/build.d.ts",
			"default": "./dist/compat/src/build.js"
		},
		"./referer": {
			"types": "./dist/referer/src/index.d.ts",
			"default": "./dist/referer/src/index.js"
		},
		"./sentry/build": {
			"types": "./dist/sentry/src/build.d.ts",
			"default": "./dist/sentry/src/build.js"
		},
		"./sentry/client": {
			"types": "./dist/sentry/src/client.d.ts",
			"default": "./dist/sentry/src/client.js"
		},
		"./sentry/server": {
			"types": "./dist/sentry/src/server.d.ts",
			"default": "./dist/sentry/src/server.js"
		},
		"./disclose": {
			"types": "./dist/disclose/src/index.d.ts",
			"default": "./dist/disclose/src/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"core-js": "^3.50.0"
	},
	"devDependencies": {
		"@sentry/sveltekit": "^11.4.0",
		"@sveltejs/kit": "^3.0.0"
	},
	"peerDependencies": {
		"@sentry/sveltekit": "^11.4.0",
		"@sveltejs/kit": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"@sentry/sveltekit": {
			"optional": true
		},
		"@sveltejs/kit": {
			"optional": true
		}
	}
}
