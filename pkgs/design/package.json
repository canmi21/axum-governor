{
	"name": "@canmi/design",
	"version": "0.0.0",
	"description": "A design system: one contract of tokens, the styles that fill it, a scale, components and layouts.",
	"keywords": [
		"canmi",
		"design-system",
		"design-tokens",
		"svelte"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/canmi21/lib.git",
		"directory": "pkgs/design"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		"./contract": {
			"types": "./dist/contract/src/index.d.ts",
			"default": "./dist/contract/src/index.js"
		},
		"./components/icon": {
			"types": "./dist/components/icon/src/optics.d.ts",
			"default": "./dist/components/icon/src/optics.js"
		},
		"./components/icon.svelte": "./dist/components/icon/src/icon.svelte",
		"./components/icon-button.svelte": "./dist/components/icon-button/src/icon-button.svelte",
		"./components/error-page/client.svelte": "./dist/components/error-page/src/client.svelte",
		"./components/error-page/offer.svelte": "./dist/components/error-page/src/offer.svelte",
		"./components/error-page/status.svelte": "./dist/components/error-page/src/status.svelte",
		"./components/nav-link.svelte": "./dist/components/nav-link/src/nav-link.svelte",
		"./layouts/shell.svelte": "./dist/layouts/shell/src/shell.svelte",
		"./scale.stylex": {
			"types": "./dist/scale/src/scale.stylex.d.ts",
			"default": "./dist/scale/src/scale.stylex.js"
		},
		"./styles/mono.css": "./dist/styles/src/mono.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown"
	},
	"devDependencies": {
		"@stylexjs/stylex": "^0.19.1",
		"@tabler/icons-svelte-runes": "^3.49.0",
		"svelte": "^5.57.1"
	},
	"peerDependencies": {
		"@stylexjs/stylex": "^0.19.1",
		"@tabler/icons-svelte-runes": "^3.49.0",
		"svelte": "^5.57.1"
	},
	"peerDependenciesMeta": {
		"@stylexjs/stylex": {
			"optional": true
		},
		"@tabler/icons-svelte-runes": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	}
}
